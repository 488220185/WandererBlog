# ============================================
# 后端选择：workbuddy（默认）| supabase
# ============================================
# workbuddy = WorkBuddy 云服务，开箱即用，无需任何配置
# supabase = 自建后端，用于 Vercel 等自有域名部署
NEXT_PUBLIC_BACKEND=workbuddy

# ============================================
# 切换到 Supabase 时必填
# ============================================
# Supabase → Settings → API Keys
# Project URL
NEXT_PUBLIC_SUPABASE_URL=
# 客户端 key：新项目是 publishable key（sb_publishable_...），
# 旧项目是 anon key（eyJ...）。填下面任一变量名都能读到。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 站点地址（绑自有域名后改成正式域名，影响 sitemap / canonical / OG）
NEXT_PUBLIC_SITE_URL=https://dev-notes-blog-23897.app.workbuddy.host

# ============================================
# 仅本地导入种子时需要，切勿提交到版本库
# ============================================
# Supabase → Settings → API Keys → Secret key（sb_secret_...）
# 旧项目用 service_role key（eyJ...）
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
